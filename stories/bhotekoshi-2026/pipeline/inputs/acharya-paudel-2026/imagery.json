   "license_note": "CC-BY-NC-4.0. NonCommercial. Acceptable for academic publication; check the licence before any commercial reuse.",
   "grade": "A1 (machine-readable provider metadata)",
   "collection_description_caveat": "The collection description states the surge entered the Bhote Koshi 'at approximately 9:15 AM local time'. That conflicts with the DHM chronology, in which 09:15 is the ALERT time and the wave had already destroyed the Syabrubesi gauge by 08:50. Treated as a provider paraphrase that conflated alert time with onset time. NOT USED.",
   "_last_verified": "2026-08-31",
   "source_ref": [
    "vantor"
   ]
  },
