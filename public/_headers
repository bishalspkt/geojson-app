# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)
#
# The app must stay frameable by any site (embeds), and it fetches data,
# tiles, imagery and media from any https origin a user, a story or an SDK
# caller points it at — so connect/img/media sources are open, while scripts
# are locked to our own origin plus the two analytics hosts.
# 'wasm-unsafe-eval': the COG decoder (geotiff) uses WebAssembly for LERC/Zstd.
# blob: workers: MapLibre and geotiff start workers from blob URLs.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.googletagmanager.com https://*.posthog.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' data: blob: https:; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors *; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Hashed build output and versioned vendor files never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# The SDK URL is stable (https://geojson.app/embed.js), so revalidate it.
/embed.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# Story documents and data change when a story is rebuilt.
/stories/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *
/samples/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
