{
  "name": "geojson.app",
  "short_name": "geojson.app",
  "description": "View, explore and share GeoJSON on an open-source map.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#4a24b8",
  "background_color": "#e8edf5",
  "icons": [
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
